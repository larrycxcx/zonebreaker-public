class_name SpriteEffect
extends Node2D
## Sprite version of short-lived effects (muzzle flash, hit sparks, wall sparks): plays its frames once, then removes itself. Display only, no collision.
##
## Directional ones (muzzle flash, wall sparks): `Fx` calls `point(direction)` to pick one of 8 ready-made images — pixel art cannot be rotated 45° at run time.
## The sprites are generated by `tools/fx_build.py` with the emission point in the middle of every frame, so the effect's origin is the muzzle / impact point.
## Direction-less ones (hitting a character): `textures` only holds one `&"still"`.

## Textures: direction name (right / up_left / …, same as ProjectileAppearance) → a row of square frames; direction-less ones only hold `still`.
@export var textures: Dictionary[StringName, Texture2D] = {}
## Frame size and frames per second.
@export var frame_size := 32
@export var fps := 30.0
## Tint (multiplied in) for art that is a white silhouette.
@export var tint := Color.WHITE

var _direction := Vector2.RIGHT
var _elapsed := 0.0

@onready var _sprite: Sprite2D = $Sprite


func _ready() -> void:
	modulate = tint
	_refresh()


## Which direction it sprays (called by Fx after spawning it).
func point(direction: Vector2) -> void:
	if direction != Vector2.ZERO:
		_direction = direction
	_refresh()


## Name of the texture in use (for tests).
func texture_name() -> StringName:
	if textures.has(&"still"):
		return &"still"
	return ProjectileAppearance.direction_name(_direction)


func _process(delta: float) -> void:
	_elapsed += delta
	var frame := int(_elapsed * fps)
	if frame >= _sprite.hframes:
		queue_free()
		return
	_sprite.frame = frame


func _refresh() -> void:
	if _sprite == null:
		return
	var texture: Texture2D = textures.get(texture_name())
	if texture == null:
		push_warning("missing effect sprite: %s" % texture_name())
		return
	_sprite.texture = texture
	_sprite.hframes = maxi(1, texture.get_width() / frame_size)
	_sprite.frame = mini(int(_elapsed * fps), _sprite.hframes - 1)
