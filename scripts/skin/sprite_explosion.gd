class_name SpriteExplosion
extends Node2D
## Sprite version of the explosion: picks the frame set whose size is closest to the blast radius and plays it once at 1:1, then removes itself (pixel art is never scaled).
## Like the placeholder explosion.gd it is display only and Grenade works out the damage; `Fx` sets `radius` after spawning it, so changing the radius picks the image again.

## Frame sets: frame size → a row of square frames (generated by tools/fx_build.py).
@export var sizes: Dictionary[int, Texture2D] = {}
@export var fps := 16.0
@export var radius := 56.0:
	set(value):
		radius = value
		_pick()

var _elapsed := 0.0

@onready var _sprite: Sprite2D = $Sprite


func _ready() -> void:
	_pick()


func _process(delta: float) -> void:
	_elapsed += delta
	var frame := int(_elapsed * fps)
	if frame >= _sprite.hframes:
		queue_free()
		return
	_sprite.frame = frame


## Which size is in use (frame size, read by tests).
func frame_size() -> int:
	return _best_size()


## The size closest to the blast diameter.
func _best_size() -> int:
	var best := 0
	for size: int in sizes:
		if best == 0 or absf(size - radius * 2.0) < absf(best - radius * 2.0):
			best = size
	return best


func _pick() -> void:
	if _sprite == null:
		return # The radius was set before _ready; pick once in _ready to catch up
	var size := _best_size()
	if size == 0:
		return
	_sprite.texture = sizes[size]
	_sprite.hframes = maxi(1, _sprite.texture.get_width() / size)
	_sprite.frame = mini(int(_elapsed * fps), _sprite.hframes - 1)
