class_name ProjectileAppearance
extends Appearance
## Sprite version of the projectile look (bullets, grenades): one Sprite2D picking a pre-drawn image for the flight direction.
##
## The sprites are generated by `tools/projectile_build.py`: 8 per bullet kind (right / left / up / down / up_right / ...),
## grenades are round and have only one (its name goes in `still`). Pixel art cannot be rotated 45° at run time (it blurs), so all 8 directions are ready-made.
## The bullet body itself rotates to its flight direction — that is the hit check (the collision shape is a thin horizontal strip); the look must not rotate with it,
## so this cancels out its own rotation and shows direction only by swapping images. Display only like the character looks: no collision, no effect on rules either way.

## Flight direction (rounded to 8 directions) → texture name.
const NAMES := {
	Vector2i(1, 0): &"right", Vector2i(-1, 0): &"left", Vector2i(0, -1): &"up", Vector2i(0, 1): &"down",
	Vector2i(1, -1): &"up_right", Vector2i(-1, -1): &"up_left", Vector2i(1, 1): &"down_right", Vector2i(-1, 1): &"down_left",
}

## Which folder the sprites live in.
@export_dir var art_dir := ""
## For direction-less ones (grenades, round bullets): the texture name; empty picks by flight direction.
@export var still := &""
## How many frames are in a row of this texture and how many play per second (a grenade tumbling in the air); 1 frame is static.
@export var frames := 1
@export var fps := 0.0

var _elapsed := 0.0

@onready var _sprite: Sprite2D = $Sprite


func _ready() -> void:
	# No super(): the base class flips by mirroring child positions, which is for the placeholder blocks.
	_refresh()


func _process(delta: float) -> void:
	if frames <= 1 or fps <= 0.0:
		return
	_elapsed += delta
	_sprite.frame = int(_elapsed * fps) % frames


func aim(direction: Vector2) -> void:
	if direction != Vector2.ZERO:
		_aim = direction
	_refresh()


## Name of the texture in use (for tests).
func texture_name() -> StringName:
	if still != &"":
		return still
	return direction_name(_aim)


## Which of the 8 images a direction maps to: the angle rounded to a multiple of 45° (the directional effect images use this too).
static func direction_name(direction: Vector2) -> StringName:
	var step := roundi(direction.angle() / (PI / 4.0))
	var snapped := Vector2.RIGHT.rotated(step * PI / 4.0)
	return NAMES[Vector2i(roundi(snapped.x), roundi(snapped.y))]


func _refresh() -> void:
	if _sprite == null:
		return # May be called before _ready; refresh once in _ready to catch up
	if is_inside_tree():
		global_rotation = 0.0
	var file := "%s/%s.png" % [art_dir, texture_name()]
	var texture: Texture2D = load(file)
	if texture == null:
		push_warning("missing projectile sprite: %s" % file)
		return
	_sprite.texture = texture
	_sprite.hframes = maxi(1, frames)
