class_name EnemySpriteAppearance
extends Appearance
## Sprite version of the enemy look: one whole image (the gun drawn on the body), picking a clip by state.
##
## The sprites are generated by `tools/enemy_build.py`: one horizontal strip of frames per clip (`<clip>_r.png` / `<clip>_l.png`),
## the left-facing set already mirrored around the anchor, so turning around just swaps the texture — no flip_h, and certainly no negative scale.
## Like the player's SpriteAppearance it only handles the picture: the hit points are on the enemy's body, and the rules are the same with or without this look.
##
## Which clip to show (highest priority first):
## dead → death (plays once and holds)
## a one-shot clip in progress → fire()'s attack, flash_hit()'s hurt
## prone → frame 1 of prone (the whole clip plays when firing)
## aiming diagonally → loop idle_up / idle_down if present (turret: the diagonal barrel still bobs up and down),
## otherwise hold frame 1 of attack_up / attack_down (a patroller holding its gun up, waiting to fire); E always aims straight down, which does not count as "diagonal"
## Hurt works the same way: while aiming diagonally use hurt_up / hurt_down if present, so a hit does not snap the barrel back to level.
## charging (D chasing) → run; in the air → air; without those two fall back to walk
## walking → walk; standing → idle

## Frame size and anchor of ground enemies (the pixel in the frame matching the enemy's body origin); must match tools/enemy_build.py.
## Wider than the player's frames: the fall throws the body forward and 56 wide is not enough. The flying E differs; its own scene changes frame_size / anchor.
const FRAME_W := 80
const FRAME_H := 56
const ANCHOR_X := 40
const ANCHOR_Y := 40

## Speed of looping clips (frames / second).
const LOOP_FPS := {&"idle": 6.0, &"idle_up": 6.0, &"idle_down": 6.0, &"walk": 10.0, &"run": 12.0}
## Speed of one-shot clips.
const ONCE_FPS := 12.0
## How long it lies on the ground after the fall, and how long it then takes to fade out.
const CORPSE_STAY := 0.4
const CORPSE_FADE := 0.4

## Aim direction → name of the firing clip.
const ATTACK_BY_AIM := {
	Vector2(1, 0): &"attack_level",
	Vector2(1, -1): &"attack_up",
	Vector2(1, 1): &"attack_down",
	Vector2(0, 1): &"attack_down", # E fires straight down
}

## Which folder the sprites live in. The three patrollers share this script and only differ in this folder (recoloured versions).
@export_dir var art_dir := "res://skins/cyberpunk/enemies/1_a"
## The boss's portrait in the HUD (changes with the skin); empty for ordinary enemies.
@export var portrait: Texture2D
## Frame size and anchor of this sprite set (set by the build script, copied into the scene).
@export var frame_size := Vector2i(FRAME_W, FRAME_H)
@export var anchor := Vector2i(ANCHOR_X, ANCHOR_Y)

@onready var _body: Sprite2D = $Body

var _motion := Motion.IDLE
var _prone := false
var _dead := false
var _elapsed := 0.0
## The one-shot clip in progress (attack, hurt) and when it started; empty means none.
var _once := &""
var _once_since := 0.0
## Hold the last frame when done (`play_once(…, true)`): stage 5's scientists transforming — the last frame already shows the mutant and holds there until the swap.
var _hold := false
## Buried: holds the first frame of the `emerge` clip (just a tread).
var _buried := false
var _dead_since := 0.0
## Whether this sprite set has a given clip (cached by name, so the file system is not asked every frame).
var _has := {}


func _ready() -> void:
	# No super(): the base class flips by mirroring child positions, which is for the placeholder blocks; this flips by swapping textures.
	_body.centered = true
	_body.offset = Vector2(frame_size) / 2.0 - Vector2(anchor)
	_refresh()


func _process(delta: float) -> void:
	_elapsed += delta
	if _once != &"" and not _dead and not _hold and _body.texture != null \
			and (_elapsed - _once_since) * ONCE_FPS >= _body.hframes:
		_once = &""
		_refresh()
		return
	_advance()


func face(facing: int) -> void:
	if facing == _facing:
		return
	_facing = facing
	_refresh()


func aim(direction: Vector2) -> void:
	if direction == Vector2.ZERO or direction == _aim:
		return
	_aim = direction
	_refresh()


func motion(state: Motion) -> void:
	if state == _motion:
		return
	_motion = state
	_refresh()


## Prone or not. There is a dedicated prone pose; no squashing, no moving down as a whole.
func pose(height_ratio: float, _lowered: float) -> void:
	var prone := height_ratio < 1.0
	if prone == _prone:
		return
	_prone = prone
	_once = &""
	_refresh()


## A shot: play the firing clip once for the current pose (the prone firing clip when prone; attack_walk if present while walking).
func fire() -> void:
	if _prone:
		_play_once(&"prone")
	elif _motion == Motion.WALK and _exists(&"attack_walk"):
		_play_once(&"attack_walk")
	else:
		_play_once(_attack_clip())


## Got hit: play hurt once (frame 2 of the art flashes the whole body red).
func flash_hit() -> void:
	_play_once(_aimed(&"hurt"))


## Size (radius) of the explosion on the spot when there is no death animation.
const DEATH_BLAST := 40.0


## Dead: the body is about to be deleted, so the look moves itself under the effects layer, plays the fall, lies a while, fades out and removes itself.
## If the effects layer is not there (e.g. a test deleted it) it hangs under the enemy's parent instead, with the same result.
func show_dead() -> void:
	if _dead:
		return
	_dead = true
	_dead_since = _elapsed
	_once = &""
	var host := get_tree().get_first_node_in_group(Fx.GROUP)
	if not _exists(&"death"):
		# Ones without a death animation (stage 5's big mechs): **blow up on the spot** and are gone. Do not load textures that do not exist —
		# that would print a "Resource file not found" every time (stage 2's 2-C diagonal shots fell into the same hole)
		var boom_scene := Skins.effect(&"explosion", null)
		if boom_scene != null and host != null:
			var boom := boom_scene.instantiate() as Node2D
			host.add_child(boom)
			boom.global_position = global_position
			boom.set(&"radius", DEATH_BLAST)
		queue_free()
		return
	if host == null:
		host = get_parent().get_parent()
	if host != null:
		reparent(host)
	_refresh()
	var dying := float(_body.hframes) / ONCE_FPS
	var tween := create_tween()
	tween.tween_interval(dying + CORPSE_STAY)
	tween.tween_property(self, "modulate:a", 0.0, CORPSE_FADE)
	tween.tween_callback(queue_free)


## Name of the clip shown now (for tests).
func clip() -> StringName:
	if _dead:
		return &"death"
	if _buried:
		return &"emerge"
	if _once != &"":
		return _once
	if _prone:
		return &"prone"
	if _aiming_diagonally():
		var idle := _aimed(&"idle")
		return idle if idle != &"idle" else _attack_clip()
	match _motion:
		Motion.WALK:
			return &"walk"
		Motion.RUN:
			return _first([&"run", &"walk"])
		Motion.JUMP, Motion.FALL:
			return _first([&"air", &"run", &"walk"])
	return &"idle"


## The firing clip for this aim direction. **If the sprites do not have it, fall back to the level one** —
## not every art set draws diagonal shots: the cyberpunk patroller comes with level / up / down,
## the industrial set only has level. Without this fallback, the moment 2-C aimed diagonally it would load a missing image,
## print a screenful of "Resource file not found", and that frame would vanish from the screen.
func _attack_clip() -> StringName:
	var wanted: StringName = ATTACK_BY_AIM.get(
		Vector2(absf(signf(_aim.x)), signf(_aim.y)), &"attack_level")
	return _first([wanted, &"attack_level"])


func _aiming_diagonally() -> bool:
	return _aim.x != 0.0 and _aim.y != 0.0


## The first clip of these the sprite set has (the last one is the fallback and not checked).
func _first(names: Array[StringName]) -> StringName:
	for name in names.slice(0, -1):
		if _exists(name):
			return name
	return names[-1]


func _exists(name: StringName) -> bool:
	if not _has.has(name):
		_has[name] = ResourceLoader.exists("%s/%s_r.png" % [art_dir, name])
	return _has[name]


## The diagonal version of this clip while aiming diagonally (`hurt` → `hurt_up`), or the original if the sprites lack it.
func _aimed(name: StringName) -> StringName:
	if not _aiming_diagonally():
		return name
	var variant := StringName("%s_%s" % [name, "up" if _aim.y < 0.0 else "down"])
	return variant if _exists(variant) else name


## Play a clip once (for gameplay: a scientist transforming). `hold` = hold the last frame when done instead of going back to idle.
## Does nothing if this sprite set does not have the clip.
func play_once(name: StringName, hold := false) -> void:
	if not _exists(name):
		return
	_play_once(name)
	_hold = hold


func show_buried(buried: bool) -> void:
	_buried = buried
	_refresh()


## Emerge: play `emerge` once (the tread slides aside, the mech rises), then back to idle.
func emerge() -> void:
	_buried = false
	play_once(&"emerge")


## How long this clip plays (seconds): one frame is 1 / `ONCE_FPS` seconds. 0 if the clip does not exist.
func once_length(name: StringName) -> float:
	if not _exists(name):
		return 0.0
	var texture: Texture2D = load("%s/%s_r.png" % [art_dir, name])
	return float(texture.get_width()) / float(frame_size.x) / ONCE_FPS


func _play_once(name: StringName) -> void:
	if _dead:
		return
	_hold = false
	_once = name
	_once_since = _elapsed
	_refresh()


func _refresh() -> void:
	if _body == null:
		return # Gameplay may call in before _ready; refresh once in _ready to catch up
	var file := "%s/%s_%s.png" % [art_dir, clip(), &"r" if _facing >= 0 else &"l"]
	var texture: Texture2D = load(file)
	if texture == null:
		push_warning("missing enemy sprite: %s" % file)
		return
	_body.texture = texture
	_body.hframes = maxi(1, texture.get_width() / frame_size.x)
	_advance()


func _advance() -> void:
	if _body == null or _body.texture == null:
		return
	var last := _body.hframes - 1
	if _dead:
		_body.frame = mini(int((_elapsed - _dead_since) * ONCE_FPS), last)
	elif _once != &"":
		_body.frame = mini(int((_elapsed - _once_since) * ONCE_FPS), last)
	elif _prone or (_aiming_diagonally() and clip() == _attack_clip()):
		_body.frame = 0 # Prone / aiming diagonally: hold the first frame, the whole clip only plays when firing
	else:
		var fps: float = LOOP_FPS.get(clip(), 0.0)
		_body.frame = int(_elapsed * fps) % _body.hframes if fps > 0.0 else 0
