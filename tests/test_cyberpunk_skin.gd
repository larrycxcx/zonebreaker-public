extends GameTest
## The cyberpunk skin pack (the first real sprite set): the player switches to `SpriteAppearance`.
##
## The point of this suite is **switching skins does not change the rules**: the same actions run with placeholder blocks and with sprites
## must give exactly the same muzzle positions, bullet heights, collision shapes, jump heights and dodge results.
## The look's own rules (complete sprites, turning by swapping images rather than negative scale) are guarded too.
## The sprites are generated by tools/skin_build.py; rerun it after changing the art.

const SKIN := "res://skins/cyberpunk/cyberpunk_skin.tres"
const ART_DIR := "res://skins/cyberpunk/biker"
const FRAME := 56

## The sprites the build should produce: every clip and every aim direction, a left-facing and a right-facing set each.
const BODY_CLIPS := ["idle", "walk", "run", "air", "crouch", "crawl", "death"]
const AIM_CLIPS := ["up", "diag_up", "level", "diag_down", "down"]
## A whole set of arm sprites per gun (`Weapon.look`), and how many pixels its muzzle may be off from the shared muzzle position.
## The two guns share one set of muzzle positions (a gameplay rule); the rifle is what they were measured on, so it is held tight;
## the grenade launcher is thick and its muzzle centre is 2~3px off, while a grenade is 8px big and arcs up as soon as it leaves, so the difference cannot be seen.
const GUN_LOOKS := {&"rifle": 2.0, &"launcher": 3.0}
## The bullet direction for each aim sprite (the same scheme as Player.aim_vector()).
const AIM_DIRECTIONS := {
	&"level": Vector2(1, 0),
	&"up": Vector2(0, -1),
	&"diag_up": Vector2(1, -1),
	&"diag_down": Vector2(1, 1),
	&"down": Vector2(0, 1),
}


func skin() -> SkinPack:
	return load(SKIN) as SkinPack


func visual() -> SpriteAppearance:
	return player.get_node("Visual") as SpriteAppearance


func press(actions: Array) -> void:
	for action: String in actions:
		Input.action_press(action)


func release(actions: Array) -> void:
	for action: String in actions:
		Input.action_release(action)


## Have the player stand on an empty patch and wait for them to settle.
func stand_at(x: float) -> void:
	player.global_position = Vector2(x, 304)
	player.velocity = Vector2.ZERO
	await frames(10)


# ---------------------------------------------------------------- The sprites themselves

func test_every_clip_is_there_and_lines_up() -> void:
	if needs_art(): return
	var names := []
	for clip in BODY_CLIPS:
		names.append("body_" + clip)
	for look: StringName in GUN_LOOKS:
		for clip in AIM_CLIPS:
			names.append("arms_%s_%s" % [look, clip])
	for base: String in names:
		for side in ["r", "l"]:
			var path := "%s/%s_%s.png" % [ART_DIR, base, side]
			var texture := load(path) as Texture2D
			check("%s_%s exists" % [base, side], texture != null, path)
			if texture == null:
				continue
			check("%s_%s is one row of %dpx frames" % [base, side, FRAME],
				texture.get_height() == FRAME and texture.get_width() % FRAME == 0,
				"%d x %d" % [texture.get_width(), texture.get_height()])


func test_the_two_facings_are_mirrors_of_each_other() -> void:
	if needs_art(): return
	# The left-facing set is mirrored around the anchor column, and the two sides must be perfectly symmetric.
	# If they disagree, the build script has cut a piece off one side — on screen the character loses a bit or shifts by a cell when turning around.
	# Only visible pixels are compared: the importer's "fix alpha border" fills fully transparent pixels with neighbours' colours, and asymmetry there does not matter.
	for base in ["body_idle", "body_run", "body_crouch", "body_crawl", "body_death", "arms_rifle_level", "arms_rifle_up", "arms_launcher_level", "arms_launcher_diag_down"]:
		var right := (load("%s/%s_r.png" % [ART_DIR, base]) as Texture2D).get_image()
		var left := (load("%s/%s_l.png" % [ART_DIR, base]) as Texture2D).get_image()
		check("%s: both facings are the same size" % base, right.get_size() == left.get_size(),
			"%s vs %s" % [right.get_size(), left.get_size()])
		if right.get_size() != left.get_size():
			continue
		var same := true
		for y in right.get_height():
			for x in right.get_width():
				var frame := x / FRAME
				var mirrored := frame * FRAME + 2 * (SpriteAppearance.ANCHOR_X) - (x - frame * FRAME)
				if mirrored < frame * FRAME or mirrored >= (frame + 1) * FRAME:
					continue
				var a := right.get_pixel(x, y)
				var b := left.get_pixel(mirrored, y)
				if a.a != b.a or (a.a > 0.0 and a != b):
					same = false
		check("%s: left is the mirror of right around the anchor" % base, same)


## The bounds of the alpha > 0 area of the sprite (frame coordinates). `rows` limits which rows are looked at.
func ink_box(texture: Texture2D, rows := Vector2i(0, FRAME - 1)) -> Rect2i:
	var image := texture.get_image()
	var left := FRAME
	var right := -1
	var top := FRAME
	var bottom := -1
	for y in range(rows.x, rows.y + 1):
		for x in FRAME:
			if image.get_pixel(x, y).a <= 0.03:
				continue
			left = mini(left, x)
			right = maxi(right, x)
			top = mini(top, y)
			bottom = maxi(bottom, y)
	return Rect2i(left, top, right - left + 1, bottom - top + 1)


func test_the_art_sits_on_the_collision_box() -> void:
	if needs_art(): return
	# The anchor is the only seam between sprites and gameplay: change ANCHOR in the build script and the whole character shifts
	# (feet sunk into the floor, or floating in the air), a shift that no gameplay test could ever notice.
	# Here it works out from the collision shape where it should be: feet 16px below the origin, the torso centre roughly on the origin's column.
	var feet := Player.STAND_HEIGHT / 2.0
	for clip in ["idle", "walk", "run"]:
		var box := ink_box(load("%s/body_%s_r.png" % [ART_DIR, clip]) as Texture2D)
		var sole := box.end.y - SpriteAppearance.ANCHOR_Y
		check("%s: the feet stand on the bottom of the box" % clip, absf(sole - feet) <= 1.0,
			"feet %.0fpx below the origin, collision shape %.0f" % [sole, feet])
		# Horizontally aligned by **the torso** (the arms attach to the torso): running, the legs swing behind, so the overall bounding box is off anyway.
		var torso := ink_box(load("%s/body_%s_r.png" % [ART_DIR, clip]) as Texture2D,
			Vector2i(box.position.y, box.position.y + 16))
		var middle := (torso.position.x + torso.end.x) / 2.0 - SpriteAppearance.ANCHOR_X
		check("%s: the torso is centred on the origin" % clip, absf(middle) <= 2.0, "off by %.1fpx" % middle)
		check("%s: the art is not wider than the frame" % clip, box.size.x <= FRAME and box.size.y <= FRAME, str(box))
	# Arms and body share one anchor, so the gun is always near the body and never flies off
	var arms := ink_box(load("%s/arms_rifle_level_r.png" % ART_DIR) as Texture2D)
	check("the level gun reaches out in front of the body",
		arms.position.x - SpriteAppearance.ANCHOR_X < 0 and arms.end.x - SpriteAppearance.ANCHOR_X > 12,
		"x %d..%d (anchor %d)" % [arms.position.x, arms.end.x, SpriteAppearance.ANCHOR_X])


func test_the_prone_art_stays_under_enemy_fire() -> void:
	if needs_art(): return
	# Lying prone to dodge bullets is a rule, and **the picture has to make sense too**: the whole prone sprite must stay below the shots of standing enemies,
	# otherwise the player sees a bullet pass through their back without losing health and thinks it is clipping.
	# The hitbox is 12px; the sprite may be a little taller (a lying body has some thickness), but not taller than the bullets.
	# The prone and crawl poses are our own drawings (art_src/biker_prone.png, native resolution); if a redraw goes outside this window, this reports it.
	await reset_scene(true, false, skin())
	keep_only_enemies(["Turret1"])
	var turret: Enemy = main.get_node("Enemies/Turret1")
	await stand_at(400)
	var ground := player.global_position.y + Player.STAND_HEIGHT / 2.0
	var bullet_height := ground - turret.level_muzzle_position().y
	check("the turret fires from above the ground", bullet_height > 0.0, "%.1f" % bullet_height)
	# The still frame and every crawl frame are guarded: the knee-tucking crawl frames have other shapes, and must neither block bullets nor sink into the floor.
	# **All three characters are checked**: it used to check biker only, while punk and cyborg each have their own prone image (see `PRONE_ART` in `skin_build.py`)
	# that was never measured — the previous punk image was 22px tall, right up against the bullets, which is how it slipped through.
	for art_dir in [ART_DIR, ART_DIR_2, ART_DIR_3]:
		var who := String(art_dir).get_file()
		for clip in ["crouch", "crawl"]:
			var image := (load("%s/body_%s_r.png" % [art_dir, clip]) as Texture2D).get_image()
			for f in image.get_width() / FRAME:
				var box := ink_box_in(image, f)
				var art_height := float(Player.STAND_HEIGHT / 2.0 + SpriteAppearance.ANCHOR_Y - box.position.y)
				var label := "%s %s frame %d" % [who, clip, f + 1]
				check("%s is shorter than the enemy's line of fire" % label,
					art_height < bullet_height, "sprite height %.0fpx, bullet above floor %.0fpx" % [art_height, bullet_height])
				# Too short, and lying down looks like it has no thickness.
				check("%s is still about as tall as the hitbox, like a body lying down" % label,
					art_height >= Player.CROUCH_HEIGHT, "sprite height %.0fpx, hitbox %d" % [art_height, Player.CROUCH_HEIGHT])
				# The upper limit **is set by the bullets alone** (the check above). It used to be "hitbox + 3" = 15px, fitted to biker's
				# image; punk's hair and cyborg's back raised in the crawl need a few pixels more, while their bodies are actually shorter than biker's.
				# What really needs guarding is "a bullet passing through the back without counting as a hit", which is the bullet line, not an arbitrary 15.
				var sole := box.end.y - SpriteAppearance.ANCHOR_Y
				check("%s lies on the ground" % label, absf(sole - Player.STAND_HEIGHT / 2.0) <= 1.0,
					"feet below the origin %.0fpx" % sole)


## The opaque area of frame frame in a multi-frame sprite (frame coordinates).
func ink_box_in(image: Image, frame: int) -> Rect2i:
	var left := FRAME
	var right := -1
	var top := FRAME
	var bottom := -1
	for y in FRAME:
		for x in FRAME:
			if image.get_pixel(frame * FRAME + x, y).a <= 0.03:
				continue
			left = mini(left, x)
			right = maxi(right, x)
			top = mini(top, y)
			bottom = maxi(bottom, y)
	return Rect2i(left, top, right - left + 1, bottom - top + 1)


func test_the_death_art_falls_backwards_onto_the_ground() -> void:
	if needs_art(): return
	# The death clip keeps the artist's original placement and is positioned once from the standing frame: the character falls backwards,
	# and realigning every frame on the torso would cancel the backward movement, turning the fall into spinning on the spot — this guards exactly that.
	var image := (load("%s/body_death_r.png" % ART_DIR) as Texture2D).get_image()
	var count := image.get_width() / FRAME
	var first := ink_box_in(image, 0)
	var last := ink_box_in(image, count - 1)
	var first_mid := (first.position.x + first.end.x) / 2.0
	var last_mid := (last.position.x + last.end.x) / 2.0
	check("the body ends up lying down", last.size.x > last.size.y and last.size.y < first.size.y,
		"first frame %s, last frame %s" % [first.size, last.size])
	# Someone facing right falling backwards = falling to the left: the head (top row) of the last frame is left of the origin
	var head_x := -1
	for x in FRAME:
		if image.get_pixel((count - 1) * FRAME + x, last.position.y).a > 0.03:
			head_x = x
			break
	check("facing right, it falls backwards (head ends up behind the origin)",
		head_x < SpriteAppearance.ANCHOR_X, "head at x=%d, origin x=%d" % [head_x, SpriteAppearance.ANCHOR_X])
	check("the fall keeps its travel instead of spinning in place", absf(last_mid - first_mid) >= 2.0,
		"bounding box centre from %.1f to %.1f" % [first_mid, last_mid])
	# Every frame lands on the ground line without sinking into it (the last frames, lying flat, matter most)
	for f in count:
		var box := ink_box_in(image, f)
		var sole := box.end.y - SpriteAppearance.ANCHOR_Y
		check("death frame %d touches the ground" % (f + 1), absf(sole - Player.STAND_HEIGHT / 2.0) <= 1.0,
			"lowest point below the origin %.0fpx" % sole)


func test_dying_plays_the_fall_once_and_stays_down() -> void:
	if needs_art(): return
	await reset_scene(false, false, skin())
	await stand_at(400)
	player.take_damage(player.health)
	# The first sample must be taken right at the moment of death: frame 0 only shows for 0.1 seconds, and looking a frame later
	# _process may already have moved on in headless mode, making the test flaky.
	var body: Sprite2D = visual().get_node("Body")
	var seen: Array[int] = [body.frame]
	await frames(1)
	check("the player is dead", player.health == 0)
	check("dying switches to the death clip", visual().body_clip() == &"death", str(visual().body_clip()))
	check("the gun is gone with the arms", not visual().get_node("Arms").visible)
	for i in 50:
		await frames(1)
		if seen.is_empty() or seen[-1] != body.frame:
			seen.append(body.frame)
	check("it plays forward through every frame, once", seen == range(body.hframes), str(seen))
	check("and stays on the last frame, lying down", body.frame == body.hframes - 1, str(body.frame))
	check("not darkened like the placeholder blocks", visual().modulate == Color.WHITE, str(visual().modulate))


func test_dying_while_lying_down_still_plays_the_fall() -> void:
	if needs_art(): return
	await reset_scene(false, false, skin())
	await stand_at(400)
	Input.action_press("crouch")
	await frames(6)
	player.take_damage(player.health)
	await frames(2)
	release_all_input()
	check("death wins over the prone pose", visual().body_clip() == &"death", str(visual().body_clip()))


# ---------------------------------------------------------------- What running looks like (picking up the pace, 2026-09)

## The two colours of bare skin (light + shade), matching SKIN_COLORS in tools/skin_build.py.
const SKIN_COLORS := [Color8(163, 109, 62), Color8(104, 60, 52)]
## The colour of the speed trail behind the Dash art.
const STREAK := Color8(255, 246, 174)
## The clips that get the aiming arms pasted on. Prone, crawl and death are drawn whole, with their own arms.
const ARMED_CLIPS := ["idle", "walk", "run", "air"]


func frames_in(image: Image) -> int:
	return image.get_width() / FRAME


## How many pixels the upper body leans ahead of the feet in this frame: a running pose leans forward, a standing pose is upright.
func lean_in(image: Image, frame: int) -> float:
	var box := ink_box_in(image, frame)
	var head := []
	var feet := []
	for y in range(box.position.y, box.end.y):
		for x in FRAME:
			if image.get_pixel(frame * FRAME + x, y).a <= 0.03:
				continue
			if y <= box.position.y + 5:
				head.append(x)
			if y >= box.end.y - 4:
				feet.append(x)
	if head.is_empty() or feet.is_empty():
		return 0.0
	var head_x := 0.0
	for x: int in head:
		head_x += x
	var feet_x := 0.0
	for x: int in feet:
		feet_x += x
	return head_x / head.size() - feet_x / feet.size()


func has_color(image: Image, want: Color) -> bool:
	for y in image.get_height():
		for x in image.get_width():
			var pixel := image.get_pixel(x, y)
			if pixel.a > 0.03 and pixel.r8 == want.r8 and pixel.g8 == want.g8 and pixel.b8 == want.b8:
				return true
	return false


## How many pixels of bare skin this frame has. The face and neck are only so many; anything more is the arm the art came with.
func skin_pixels(image: Image, frame: int) -> int:
	var found := 0
	for y in FRAME:
		for x in FRAME:
			var pixel := image.get_pixel(frame * FRAME + x, y)
			if pixel.a <= 0.03:
				continue
			for skin_color: Color in SKIN_COLORS:
				if pixel.r8 == skin_color.r8 and pixel.g8 == skin_color.g8 and pixel.b8 == skin_color.b8:
					found += 1
	return found


func test_walking_shows_the_running_animation() -> void:
	if needs_art(): return
	# Playtesters found the pace slow, so **normal movement uses the art's run directly** (no speed changed by a single number).
	# A running pose leans the whole body forward, a walking pose is upright — measuring that tells which clip is used.
	var walk := (load("%s/body_walk_r.png" % ART_DIR) as Texture2D).get_image()
	var idle := (load("%s/body_idle_r.png" % ART_DIR) as Texture2D).get_image()
	var leaning := 0.0
	for frame in frames_in(walk):
		leaning = maxf(leaning, lean_in(walk, frame))
	var standing := 0.0
	for frame in frames_in(idle):
		standing = maxf(standing, lean_in(idle, frame))
	check("the walk clip leans forward like a run", leaning >= 6.0, "leaning %.1fpx" % leaning)
	# Control: standing still measured with the same ruler must come out very small, otherwise the check above proves nothing
	check("standing still does not lean", standing < 3.0, "leaning %.1fpx" % standing)


func test_hanging_in_the_air_is_one_single_pose() -> void:
	if needs_art(): return
	# There is only one pose in the air, so the sprite itself has only one frame — with two, at run time there would always be a chance of switching mid-air.
	var air := (load("%s/body_air_r.png" % ART_DIR) as Texture2D).get_image()
	check("the air clip is a single frame", frames_in(air) == 1, "%d frames" % frames_in(air))
	# Control: walking measured with the same ruler comes out as a whole set, showing the check above is not reading the wrong image
	var walk := (load("%s/body_walk_r.png" % ART_DIR) as Texture2D).get_image()
	check("while walking is a whole cycle", frames_in(walk) > 1, "%d frames" % frames_in(walk))


func test_sprinting_shows_the_dash() -> void:
	if needs_art(): return
	# The sprint switched to the art's Dash: a trail behind the body. Speed is still the original 270; it just looks like dashing.
	for side in ["r", "l"]:
		var run := (load("%s/body_run_%s.png" % [ART_DIR, side]) as Texture2D).get_image()
		check("the sprint clip (%s) trails a speed streak" % side, has_color(run, STREAK))
	for clip in ["walk", "idle", "air"]:
		var image := (load("%s/body_%s_r.png" % [ART_DIR, clip]) as Texture2D).get_image()
		check("%s does not" % clip, not has_color(image, STREAK))


func test_no_clip_brings_its_own_arms() -> void:
	if needs_art(): return
	# The aiming arms are pasted on separately, so the body images must have **their arms stripped**.
	# In the art pack only `*2.png` comes without arms; Idle1, Dash and the like have them, and the build script strips them;
	# if the art were ever overwritten, or the build script skipped this step, the character would grow three arms — this guards exactly that.
	# The face and neck are the same skin colour, so it judges by "how much bare skin per frame": stripped ones have at most twenty-odd pixels, unstripped ones fifty or more.
	for clip in ARMED_CLIPS:
		var image := (load("%s/body_%s_r.png" % [ART_DIR, clip]) as Texture2D).get_image()
		var most := 0
		for frame in frames_in(image):
			most = maxi(most, skin_pixels(image, frame))
		check("%s has no arms of its own" % clip, most <= 30, "at most %d pixels of bare skin" % most)
	# Control: the death clip is drawn whole (with its own arms, no gun), so the same ruler should give a big number
	var death := (load("%s/body_death_r.png" % ART_DIR) as Texture2D).get_image()
	var death_skin := 0
	for frame in frames_in(death):
		death_skin = maxi(death_skin, skin_pixels(death, frame))
	check("while the death clip, which keeps its arms, measures far more", death_skin > 40, str(death_skin))



# ---------------------------------------------------------------- Player 2 (Punk)

## The sprites of the other two selectable characters. Same build script, same spec, just a different person in the art.
const ART_DIR_2 := "res://skins/cyberpunk/punk"
const ART_DIR_3 := "res://skins/cyberpunk/cyborg"


func test_every_character_gets_a_full_set_of_their_own() -> void:
	if needs_art(): return
	for dir_ in [ART_DIR_2, ART_DIR_3]:
		var missing := []
		for clip in BODY_CLIPS:
			for side in ["r", "l"]:
				var path := "%s/body_%s_%s.png" % [dir_, clip, side]
				if not ResourceLoader.exists(path):
					missing.append(path)
		for look: StringName in GUN_LOOKS:
			for aim in AIM_CLIPS:
				for side in ["r", "l"]:
					var path := "%s/arms_%s_%s_%s.png" % [dir_, look, aim, side]
					if not ResourceLoader.exists(path):
						missing.append(path)
		check("%s has every clip the first one has" % dir_.get_file(), missing.is_empty(), str(missing))


func test_the_three_characters_look_like_three_people() -> void:
	if needs_art(): return
	# Two players on one screen must be told apart, so the three sets must all differ from each other (pointing at the wrong folder would point back at the same set).
	for pair in [[ART_DIR, ART_DIR_2], [ART_DIR, ART_DIR_3], [ART_DIR_2, ART_DIR_3]]:
		var differ := 0
		for clip in ["idle", "walk", "run"]:
			var one := (load("%s/body_%s_r.png" % [pair[0], clip]) as Texture2D).get_image()
			var two := (load("%s/body_%s_r.png" % [pair[1], clip]) as Texture2D).get_image()
			if one.get_data() != two.get_data():
				differ += 1
		check("%s and %s are different people" % [pair[0].get_file(), pair[1].get_file()], differ == 3,
			"%d / 3 sets differ" % differ)


func test_every_character_lines_up_exactly_like_the_first() -> void:
	if needs_art(): return
	# Switching characters must not move the hit checks: the anchor is the only seam between sprites and gameplay, so both sets must sit in the same place,
	# otherwise player 2's bullets would come out at a different height.
	# Only compare the clips standing on the ground: in the air the legs are tucked, by different amounts per person; that is the drawing, not misplacement
	for dir_ in [ART_DIR_2, ART_DIR_3]:
		for clip in ["idle", "walk", "run"]:
			var one := ink_box(load("%s/body_%s_r.png" % [ART_DIR, clip]) as Texture2D)
			var two := ink_box(load("%s/body_%s_r.png" % [dir_, clip]) as Texture2D)
			check("%s %s: the feet stand on the same line" % [dir_.get_file(), clip], one.end.y == two.end.y,
				"%d vs %d" % [one.end.y, two.end.y])
		var arms_one := ink_box(load("%s/arms_rifle_level_r.png" % ART_DIR) as Texture2D)
		var arms_two := ink_box(load("%s/arms_rifle_level_r.png" % dir_) as Texture2D)
		check("%s: the gun reaches out to the same place" % dir_.get_file(), arms_one == arms_two,
			"%s vs %s" % [arms_one, arms_two])


func test_the_other_characters_art_is_mirrored_too() -> void:
	if needs_art(): return
	for dir_ in [ART_DIR_2, ART_DIR_3]:
		for clip in ["idle", "walk", "crouch"]:
			var right := (load("%s/body_%s_r.png" % [dir_, clip]) as Texture2D).get_image()
			var left := (load("%s/body_%s_l.png" % [dir_, clip]) as Texture2D).get_image()
			var same := true
			for y in right.get_height():
				for x in right.get_width():
					var frame := x / FRAME
					var mirrored := frame * FRAME + 2 * SpriteAppearance.ANCHOR_X - (x - frame * FRAME)
					if mirrored < frame * FRAME or mirrored >= (frame + 1) * FRAME:
						continue
					var a := right.get_pixel(x, y)
					var b := left.get_pixel(mirrored, y)
					if a.a != b.a or (a.a > 0.0 and a != b):
