	var side := body.get_height()
	var frame := body.get_region(Rect2i(0, 0, side, side))
	var face := _ink(shot.get_image())
	var bare := _ink(frame)
	check("it brings the arm the game body had stripped", face > bare + 40,
		"portrait %d pixels, body %d" % [face, bare])


