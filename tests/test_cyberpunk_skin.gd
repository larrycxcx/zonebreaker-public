## The body sprites **must have their arms stripped**: the aiming arms are pasted on separately, and leaving one on the body makes three arms.
## `portrait.png` is **the original art** of the same character's same idle frame (arm included, see `UiKit.portrait()`),
## which makes the most direct control: stripped cleanly, the body has a whole arm's worth of pixels fewer than the original.
##
## **`strip_arms()` only works for biker**: it finds arms by connected areas of skin colour, while punk's arm is wrapped in a sleeve
## and cyborg's is entirely armour, so not a single pixel matches and they stay as they are — of the three characters only biker is stripped by the program;
## punk and cyborg use armless images we made ourselves (`art_src/<character>_idle.png`, see `own_body()` in `skin_build.py`).
##
## **The sprint clip (`run` ← the art's Dash) is checked too**: it is a separate path from idle, and a fixed idle does not mean a fixed sprint;
## punk's and cyborg's sprint still had the original arm for a while (frames 1 and 6 of `Dash` are the idle pose, frames 2~5 are different,
## cannot be derived and had to be drawn separately). `walk` and `air` use the art pack's own armless versions and are not checked here —
## they have no "armed original of the same pose" to compare with.
const ARMLESS_CLIPS := ["idle", "run"]


func test_the_body_art_has_its_arms_stripped() -> void:
	if needs_art(): return
	await reset_scene(false, false, skin())
	for art_dir in [ART_DIR, ART_DIR_2, ART_DIR_3]:
		var who := String(art_dir).get_file()
		var drawn := _ink(UiKit.portrait(StringName(who)).get_image())
		check("%s has a portrait to compare against" % who, drawn > 0)
		for clip: String in ARMLESS_CLIPS:
			var sheet := (load("%s/body_%s_r.png" % [art_dir, clip]) as Texture2D).get_image()
			var side := sheet.get_height()
			var body := _ink(sheet.get_region(Rect2i(0, 0, side, side)))
			check("%s %s lost an arm's worth of pixels" % [who, clip], body < drawn - 20,
				"body %d pixels, original art %d" % [body, drawn])


